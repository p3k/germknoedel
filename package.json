{
  "author": "Tobi Schäfer <interface@p3k.org>",
  "bin": {
    "germknoedel": "dist/bin/germknoedel.js"
  },
  "bugs": {
    "url": "https://github.com/p3k/germknoedel/issues"
  },
  "dependencies": {
    "chalk": "5.6.2",
    "command-line-args": "6.0.2",
    "command-line-usage": "7.0.4"
  },
  "description": "Passport code generator",
  "devDependencies": {
    "@types/command-line-args": "5.2.3",
    "@types/command-line-usage": "5.0.4",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.3",
    "mocha": "12.0.2",
    "typescript": "7.0.2"
  },
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "homepage": "https://github.com/p3k/germknoedel#readme",
  "keywords": [
    "passport",
    "checksum",
    "command-line"
  ],
  "license": "LGPL-3.0-or-later",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "name": "germknoedel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p3k/germknoedel.git"
  },
  "scripts": {
    "build": "tsc && cp authorities.json package.json dist/",
    "test": "npm run build && mocha dist/test/main.js",
    "typecheck": "tsc --noEmit",
    "version": "node -e \"const fs=require('node:fs');const jsr=JSON.parse(fs.readFileSync('jsr.json'));jsr.version=process.env.npm_package_version;fs.writeFileSync('jsr.json',JSON.stringify(jsr,null,2)+'\\n')\" && git add jsr.json",
    "deno": "deno run --allow-read --allow-env bin/germknoedel.ts"
  },
  "types": "dist/index.d.ts",
  "type": "module",
  "version": "4.0.1"
}
