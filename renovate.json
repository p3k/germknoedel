{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "security:minimumReleaseAgeNpm",
    ":automergeMajor",
    ":pinVersions",
    ":semanticCommitsDisabled"
  ],
  "constraints": {
    "node": ">=20.19.0"
  },
  "constraintsFiltering": "strict",
  "packageRules": [
    {
      "matchDatasources": [
        "node-version"
      ],
      "enabled": false,
      "description": "Node.js versions here describe the range this package supports, so `:pinVersions` must not pin `engines.node`, `constraints.node` or .nvmrc to whatever the latest release happens to be"
    }
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "urgent"
    ],
    "automerge": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "labels": [
    "dependency"
  ]
}
