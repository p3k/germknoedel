{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "security:minimumReleaseAgeNpm",
    ":automergeMajor",
    ":pinVersions",
    ":semanticCommitsDisabled"
  ],
  "constraints": {
    "node": "26.10.0"
  },
  "constraintsFiltering": "strict",
  "packageRules": [
    {
      "matchDepTypes": [
        "engines"
      ],
      "enabled": false,
      "description": "`engines.node` declares the supported range, so `:pinVersions` must not pin it to whatever the latest Node.js release happens to be"
    }
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "urgent"
    ],
    "automerge": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "labels": [
    "dependency"
  ]
}
