{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "npm:unpublishSafe",
    ":automergeMajor",
    ":pinVersions",
    ":semanticCommitsDisabled"
  ],
  "constraints": {
    "node": "26.10.0"
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "mocha"
      ],
      "allowedVersions": "<12",
      "description": "Mocha 12 uses import attributes (`with { type: \"json\" }`) which Node.js 16 cannot parse"
    },
    {
      "matchPackageNames": [
        "chalk"
      ],
      "allowedVersions": "<6",
      "description": "Chalk 6 requires Node.js >=22 – see the `engines.node` field in package.json"
    }
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "urgent"
    ],
    "automerge": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "labels": [
    "dependency"
  ]
}
